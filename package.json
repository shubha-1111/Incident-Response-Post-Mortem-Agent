{
  "name": "incident-response-agent",
  "version": "1.0.0",
  "description": "6-Tier Autonomous Threat Mitigation & Learning Loop Engine",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm src/index.ts",
    "clean": "rm -rf dist src/frontend/dist",
    "build:backend": "tsc",
    "build:frontend": "cd src/frontend && npm install && npx vite build",
    "build": "npm run clean && npm run build:backend && npm run build:frontend",
    "start": "node dist/index.js",
    "test": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm src/tests/integration.test.ts",
    "test:featherless": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm src/scripts/test-featherless.ts",
    "setup": "npm install --legacy-peer-deps",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:schema": "psql \"$DATABASE_URL\" -f sql/schema-postgres.sql",
    "migrate": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm src/scripts/migrate-sqlite-to-postgres.ts",
    "verify:migration": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm src/scripts/verify-migration.ts",
    "redis:benchmark": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm src/scripts/benchmark-redis.ts",
    "kafka:benchmark": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm src/scripts/benchmark-kafka.ts",
    "kafka:topics": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm src/scripts/create-topics.ts"
  },
  "dependencies": {
    "@ai-sdk/cohere": "^3.0.46",
    "@ai-sdk/groq": "^3.0.49",
    "@mastra/core": "^0.10.15",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.41.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.48.0",
    "@opentelemetry/sdk-node": "^0.48.0",
    "@qdrant/js-client-rest": "^1.8.0",
    "axios": "^1.6.8",
    "cohere-ai": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "groq-sdk": "^1.3.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.4.1",
    "jose": "^5.2.4",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "openai": "^4.38.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "mastra": "^0.10.15",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
