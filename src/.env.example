# Get exact endpoint URLs from https://app.enkryptai.com
# after creating your Skill Sentinel and Rayder projects
ENKRYPT_SKILL_SENTINEL_URL=https://YOUR_ENDPOINT_FROM_ENKRYPT_DASHBOARD/skill-sentinel
ENKRYPT_RAYDER_URL=https://YOUR_ENDPOINT_FROM_ENKRYPT_DASHBOARD/rayder
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# ===========================================================================
# Optional production backends (Phase 0). Leave disabled to keep SQLite dev.
# Enable each by setting the USE_* flag to "true" and filling the connection.
# ===========================================================================

# --- PostgreSQL / TimescaleDB ---
USE_POSTGRES=false
# From docker-compose.yml: postgres://ir_user:ir_password@localhost:5432/incident_response
DATABASE_URL=postgres://ir_user:ir_password@localhost:5432/incident_response
PG_POOL_MAX=20
PG_SSL=false

# --- Redis Cluster (IOC / hot-path cache) ---
USE_REDIS=false
REDIS_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003
REDIS_PASSWORD=

# --- Apache Kafka (event streaming) ---
USE_KAFKA=false
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=false
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SASL_MECHANISM=plain
