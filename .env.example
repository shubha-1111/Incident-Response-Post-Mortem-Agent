# Application Configuration
PORT=3001
NODE_ENV=production

# Authentication Settings
# Provide a JWT secret of at least 32 characters in production.
# If omitted on startup, a secure random key will be generated dynamically.
JWT_SECRET=
JWT_EXPIRY=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# AI Providers
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
FEATHERLESS_API_KEY=your_featherless_api_key_here

# Vector Database (Qdrant)
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Security Guardrails (Enkrypt AI Guardrails Detect API)
# Get your API key from https://app.enkryptai.com — required, requests fail without it.
ENKRYPT_API_KEY=your_enkrypt_api_key_here
# Both default to https://api.enkryptai.com/guardrails/detect if left unset.
# Only override if Enkrypt gave you a project-specific endpoint from the dashboard.
ENKRYPT_GUARDRAILS_URL=https://api.enkryptai.com/guardrails/detect
ENKRYPT_RAYDER_URL=https://api.enkryptai.com/guardrails/detect

# Threat Intelligence & Integrations
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# Configuration Management Database (CMDB) & Webhook Sink
CMDB_API_URL=http://mock-cmdb-api.local
CMDB_API_KEY=mock-cmdb-key
INCIDENT_SINK_URL=http://mock-incident-sink.local

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=incident-response-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
