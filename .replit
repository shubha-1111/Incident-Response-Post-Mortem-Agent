modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 4322
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "5000"
ADMIN_PASSWORD = "admin"
ADMIN_USERNAME = "admin"
CISA_KEV_FEED_URL = "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
JWT_EXPIRY = "3600"
OTEL_SERVICE_NAME = "incident-response-agent"
CMDB_API_URL = "http://mock-cmdb-api.local"
ENKRYPT_RAYDER_URL = "https://rayder.enkryptai.com/api/v1/projects/CqGh5GzPt5UkI6hjdLCGzqq9KYltSAm6/rayder"
ENKRYPT_SKILL_SENTINEL_URL = "https://sentinel.enkryptai.com/api/v1/projects/CqGh5GzPt5UkI6hjdLCGzqq9KYltSAm6/skill-sentinel"
INCIDENT_SINK_URL = "http://mock-incident-sink.local"
OTEL_EXPORTER_OTLP_ENDPOINT = "http://localhost:4317"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000
